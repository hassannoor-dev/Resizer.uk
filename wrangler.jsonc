{
  // TIP: this MUST match your Worker's name in the Cloudflare dashboard (Workers & Pages list). Copy it exactly.
    "name": "resizer-uk",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-21",
  // TIP: the URL is not secret, so it can live here. NEVER put the secret key in this file.
  "vars": { "SUPABASE_URL": "https://ljyglfwgwylfemyyxxhl.supabase.co" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // TIP: only /api/ requests go to the script first; everything else is served as files
    "run_worker_first": ["/api/*"]
  }
}